# Copy to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.
# Comments are on their own lines on purpose: Docker Compose and python-dotenv
# disagree about inline comments after empty values.

# ---------------- Runtime ----------------
# local | ci | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text (human readable) | json (CloudWatch-friendly)
LOG_FORMAT=text

# ---------------- PostgreSQL ----------------
# Use "postgres" inside docker compose (compose sets this for you).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sales_dw
DATABASE_USER=sales_user
# Any value works for the local Docker database; use a strong one anywhere else.
DATABASE_PASSWORD=change-me

# ---------------- Storage ----------------
# local | s3
STORAGE_BACKEND=local
# Root of raw/ processed/ rejected/ when STORAGE_BACKEND=local
LOCAL_DATA_DIR=data
# Where the simulated upstream CSV exports land
SOURCE_DATA_DIR=data/source

# ---------------- AWS (only needed when STORAGE_BACKEND=s3) ----------------
AWS_REGION=us-east-1
# Your bucket name, e.g. my-company-sales-lake (required when STORAGE_BACKEND=s3)
S3_BUCKET=
# Optional key prefix inside the bucket, e.g. dev
S3_PREFIX=
# Static keys are for LOCAL experiments only. boto3 reads them directly from the
# environment; the application never stores or logs them. Prefer an AWS CLI profile
# (AWS_PROFILE) locally, and an IAM role (no keys at all) in AWS.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------- Simulated payments REST API ----------------
# Use http://mock-api:8000 inside docker compose (compose sets this for you).
API_BASE_URL=http://localhost:8000
API_PAGE_SIZE=100
API_TIMEOUT_SECONDS=10
API_MAX_RETRIES=3
API_BACKOFF_SECONDS=1.0
# Bearer token, if a real API needs one
# API_TOKEN=

# ---------------- Data quality ----------------
# Fail the run if more than this fraction of any feed is rejected
MAX_REJECTION_RATE=0.20
